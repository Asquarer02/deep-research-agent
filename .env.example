# Copy this file to `.env` and fill in your own values.

# Required — used by all agents (planning, search, writing, email).
# Create a key at https://platform.openai.com/api-keys (make sure the project is active).
OPENAI_API_KEY=sk-proj-your-key-here

# Required only for the final "send email" step.
# Create a key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-key-here

# Email addresses for the report delivery step.
# MAIL_FROM_EMAIL must be a verified sender in your SendGrid account.
MAIL_FROM_EMAIL=you@example.com
MAIL_TO_EMAIL=recipient@example.com
